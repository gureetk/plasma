    <string name="player_engine">Player Engine</string>
    <string name="player_engine_text_vlc">VLC plays almost any IPTV stream, including MPEG-2, interlaced sports, teletext and multicast. If a stream won’t start, Plasma tries the next engine by itself.</string>
    <string name="player_engine_text_mpv">mpv plays live TV with fine control of the picture, and can turn surround sound into Dolby Digital. If a stream won’t start, Plasma tries the next engine by itself.</string>
    <string name="player_engine_text_media3">The Android player plays Dolby Vision and HDR10+ the way the TV intends, and suits movies best. If a stream won’t start, Plasma tries the next engine by itself.</string>
    <string-array name="engine_options">
        <item>VLC</item>
        <item>mpv</item>
        <item>Android player</item>
    </string-array>
