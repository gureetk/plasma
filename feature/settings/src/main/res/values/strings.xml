    <string name="engine_media3_line">Media3 · Dolby Vision and HDR10+ movies</string>
    <string name="engine_default">Default</string>
    <string name="engine_backup">Backup</string>
    <string name="engine_hdr">HDR movies</string>
    <string name="engine_note">Plasma remembers the engine that worked for each channel. Change it from the player’s options.</string>
