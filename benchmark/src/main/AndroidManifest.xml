<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app's benchmark build, which the benchmarks start. -->
    <queries>
        <package android:name="ca.gureet.plasma.benchmark" />
    </queries>

    <application>
        <!-- Behind Plasma Benchmark while the benchmarks measure, in place of the TV's own Home. -->
        <activity
            android:name=".Backdrop"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
