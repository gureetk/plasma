<?xml version="1.0" encoding="utf-8"?>
<!-- Providers serve plain http, and the stream hub serves the engine on http://127.0.0.1 (brief 6.8). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
