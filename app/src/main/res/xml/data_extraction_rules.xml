<?xml version="1.0" encoding="utf-8"?>
<!-- Plasma keeps logins and tokens on the device. Nothing goes to Android's cloud backup or device transfer;
     Settings › Backup has Plasma's own export instead (brief 5.17). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
