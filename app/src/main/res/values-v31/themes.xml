<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android's own splash screen (12 and later) is plain graphite without an icon, so Plasma's
         launch screen follows it unseen (#158, the owner's logo of 30 October 2026). -->
    <style name="Theme.Plasma" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/plasma_bg</item>
        <item name="android:colorBackground">@color/plasma_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/plasma_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
    </style>
</resources>
