<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Plasma" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/plasma_bg</item>
        <item name="android:colorBackground">@color/plasma_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The small window (brief 5.20): only the picture, on black. -->
    <style name="Theme.Plasma.Window">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>
</resources>
